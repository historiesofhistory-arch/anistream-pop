# ─────────────────────────────────────────────────────────────────────────────
# AniStream — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# Render / Railway: set these in the dashboard's "Environment" tab instead.
#
# ⚠️  IMPORTANT: This file is committed to a PUBLIC repo.
#     Never put production URLs / secrets here. Keep them in your hosting
#     platform's environment variables only.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP port ───────────────────────────────────────────────────────────────
# Render / Railway AUTO-INJECT this — don't set manually on those platforms.
PORT=8080

# ── Vite base path ──────────────────────────────────────────────────────────
BASE_PATH=/

# ── Your site domain (optional, for CORS lockdown) ──────────────────────────
# Leave empty in dev (CORS opens up to localhost).
WEB_DOMAIN=

# ── Embed / Stream API origin (REQUIRED in production) ──────────────────────
# The origin of YOUR hosted embed/stream API. This is what the Core, AniNico,
# VidStream, and ReAnime providers call under the hood to resolve stream URLs
# AND to fetch checked audio availability via the /pop endpoint.
#
# URL structures used by the providers:
#   Stream:  {EMBED_API_URL}/api/stream/anix.at/{anilistId}/{epNum}/{type}
#   Pop:     {EMBED_API_URL}/api/stream/anix.at/{anilistId}/{epNum}/pop
#            (returns servers[] with pre-checked sub/dub/hsub per provider)
#
# Host your own instance of the embed API (Render / Railway / Koyeb / custom
# domain) and set its origin here. DO NOT use someone else's URL.
#
# Examples:
#   EMBED_API_URL=https://your-embed-api.onrender.com
#   EMBED_API_URL=https://your-embed-api.up.railway.app
#   EMBED_API_URL=https://stream.your-domain.com
EMBED_API_URL=

# ── Episode metadata + clear-logo API origin (optional) ──────────────────────
# The origin of the API that supplies per-episode thumbnails + the anime's
# clear-logo PNG. Used by the /anime/:id/episodes and /anime/:id/logo routes.
# Defaults to api.bine.me — same data just4anime provided, but with richer
# per-episode data (multiple image-quality variants, simkl_id, tvdb season/ep).
# Override via this env var if you self-host.
EPISODES_API_URL=https://api.bine.me

# ── MyAnimeList integration (optional, PARKED) ───────────────────────────────
# Switch the data source for catalog pages (home, search, browse, details,
# schedule) from AniList (default) to MyAnimeList.
#
# When DATA_SOURCE=mal:
#   - Catalog pages call MAL's official API instead of AniList
#   - Posters, synopses, scores, etc. come from MAL
#   - Stream/episode IDs STILL use AniList (server runs on AniList)
#   - The mapping (AniList ID ↔ MAL ID) is done server-side via AniList's
#     idMal field — frontend URLs never change
#
# When DATA_SOURCE=anilist (default):
#   - All catalog data comes from AniList (current behavior, unchanged)
#   - MAL_CLIENT_ID is ignored
#
# Values: anilist | mal
DATA_SOURCE=anilist

# MAL official API client ID. Required when DATA_SOURCE=mal.
# Get one at: https://myanimelist.net/apiconfig/create
# Leave empty if DATA_SOURCE=anilist (the default).
# This is a public client ID (not a secret) — used in the X-MAL-Client-ID
# header. Safe to expose in the bundle, but we read it server-side only.
MAL_CLIENT_ID=

# ── Proxy secret (optional) ─────────────────────────────────────────────────
# Signs proxy URLs. If unset, uses a built-in default.
# Set to a custom value only if you want to invalidate signed URLs on redeploy.
PROXY_SECRET=

# ── Schedule: Miruro API toggle (optional) ───────────────────────────────────
# If true, upcoming schedule data is fetched from the Miruro API FIRST, then
# merged with AniList for past episodes. Gives the most complete weekly
# schedule (past from AniList + upcoming from Miruro).
# If false, all schedule data comes from AniList only.
# If Miruro fails, silently falls back to AniList — site is never affected.
USE_MIRURO_SCHEDULE=true

# ── Miruro API URL (optional) ───────────────────────────────────────────────
# The base URL of YOUR hosted Miruro schedule API instance.
# Leave empty to use the public default. Host your own for production traffic.
MIRURO_API_URL=

# ── Node environment ────────────────────────────────────────────────────────
NODE_ENV=production

# ── Static frontend directory (set automatically by Dockerfile) ─────────────
STATIC_DIR=/app/public
